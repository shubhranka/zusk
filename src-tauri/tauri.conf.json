{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zusk",
  "version": "0.1.0",
  "identifier": "dev.zusk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zusk",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0E1012",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A calm, fast desktop client for PostgreSQL",
    "longDescription": "Zusk is a desktop client for exploring and querying PostgreSQL. Sessions start read-only, enforced by the server, and passwords live in the OS keychain.",
    "copyright": "Copyright © 2026 Shubhranka Varma",
    "homepage": "https://github.com/shubhranka/zusk",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
