{
  "name": "zusk",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, fast desktop client for PostgreSQL. Read-only until you say otherwise.",
  "license": "MIT",
  "author": "Shubhranka Varma",
  "homepage": "https://github.com/shubhranka-z/zusk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhranka-z/zusk.git"
  },
  "bugs": "https://github.com/shubhranka-z/zusk/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "dev:bridge": "cargo run --manifest-path src-tauri/Cargo.toml --example dev_bridge",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
